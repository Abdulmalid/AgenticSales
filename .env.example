# copy to .env (gitignored) and fill in. Never commit real keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=        # required if your Anthropic key is not workspace-scoped
MODEL_PROVIDER=gemini          # or: anthropic
# optional model overrides
# CONVERSATION_MODEL=gemini-flash-lite-latest
# REASONING_MODEL=gemini-3-flash-preview
# EXTRACTOR_MODEL=gemini-flash-lite-latest
# IMAGE_MODEL=gemini-2.5-flash-image
